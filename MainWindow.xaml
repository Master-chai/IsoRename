<Window x:Class="IsoRename.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ISO 图纸归档" Width="1160" Height="720" MinWidth="830" MinHeight="545" Background="#FFFFFF" Foreground="#243247" FontFamily="Microsoft YaHei UI" FontSize="14" WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="DropFiles">
 <Window.Resources>
  <SolidColorBrush x:Key="Paper" Color="#FFFFFF"/><SolidColorBrush x:Key="Ink" Color="#243247"/><SolidColorBrush x:Key="Blue" Color="#2563EB"/>
  <Style TargetType="Button">
   <Setter Property="Padding" Value="13,7"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="MinHeight" Value="34"/>
   <Setter Property="Background" Value="{StaticResource Paper}"/><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="BorderBrush" Value="{StaticResource Ink}"/>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Background" Value="{StaticResource Blue}"/><Setter Property="Foreground" Value="{StaticResource Paper}"/><Setter Property="BorderBrush" Value="{StaticResource Blue}"/><Setter Property="FontWeight" Value="SemiBold"/>
  </Style>
 </Window.Resources>
 <Grid Margin="26">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel>
   <TextBlock Text="PDMS 图纸工具  /  v1.0" Foreground="{StaticResource Blue}" FontSize="13" FontWeight="SemiBold"/>
   <TextBlock Text="ISO 图纸归档" FontSize="30" FontWeight="SemiBold" Margin="0,3,0,4"/>
   <TextBlock Text="一起拖入同名 PDF 和 DXF，从 DXF 读取档案号。只复制和重命名，不改变图纸内容。" TextWrapping="Wrap" Margin="0,0,0,18"/>
  </StackPanel>
  <WrapPanel Grid.Row="1" Margin="0,0,0,10">
   <TextBlock Text="1  导入" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/>
   <Button Content="添加图纸…" Click="Add"/><Button Content="导入文件夹…" Click="Folder"/><Button Content="重新识别" Click="Scan"/><Button Content="清空" Click="Clear"/>
   <TextBlock Text="也可拖入 DXF／PDF" VerticalAlignment="Center" Margin="7,0,0,0"/>
  </WrapPanel>
  <Grid Grid.Row="2" Margin="0,0,0,10">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock Text="2  输出文件夹" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/>
   <TextBox x:Name="OutputPath" Grid.Column="1" VerticalContentAlignment="Center" Padding="8" Margin="0,0,8,0" BorderBrush="{StaticResource Ink}" TextChanged="PathChanged" AutomationProperties.Name="输出文件夹"/>
   <Button Grid.Column="2" Content="浏览…" Click="BrowseOutput"/><Button Grid.Column="3" Content="打开文件夹" Click="OpenOutput" Margin="0"/>
  </Grid>
  <WrapPanel Grid.Row="3" Margin="0,0,0,8">
   <TextBlock Text="3  核对预览" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/>
   <Button x:Name="SourceButton" Content="打开原图" Click="OpenSource" IsEnabled="False"/>
   <CheckBox x:Name="Pending" Content="只看待处理" VerticalAlignment="Center" Margin="5,0,0,0" Checked="FilterChanged" Unchecked="FilterChanged"/>
  </WrapPanel>
  <DataGrid Grid.Row="4" x:Name="Table" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
   Background="{StaticResource Paper}" Foreground="{StaticResource Ink}" RowBackground="{StaticResource Paper}" RowHeight="36" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
   BorderBrush="{StaticResource Ink}" SelectionMode="Single" SelectionChanged="SelectionChanged">
   <DataGrid.Columns>
    <DataGridTextColumn Header="原文件名" Binding="{Binding Original}" Width="1.1*" MinWidth="132"/>
    <DataGridTextColumn Header="拟用文件名" Binding="{Binding NewName}" Width="1.65*" MinWidth="220"/>
    <DataGridTextColumn Header="编号来源" Binding="{Binding Source}" Width=".58*" MinWidth="83"/>
    <DataGridTextColumn Header="状态 / 诊断" Binding="{Binding Status}" Width="1.28*" MinWidth="190"/>
   </DataGrid.Columns>
  </DataGrid>
  <DockPanel Grid.Row="5" Margin="0,14,0,0">
   <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="输出可归档副本" Click="Export" Style="{StaticResource Primary}" Margin="12,0,0,0" IsEnabled="False"/>
   <TextBlock x:Name="Summary" VerticalAlignment="Center" Text="尚未导入图纸。" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
  </DockPanel>
 </Grid>
</Window>
